{
  "manifestVersion": 5,
  "id": "com.editassist.premiere",
  "name": "editassist",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "editassistPanel",
      "label": { "default": "editassist" },
      "minimumSize": { "width": 240, "height": 160 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 420 },
      "preferredFloatingSize": { "width": 360, "height": 460 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "allowCodeGenerationFromStrings": true
  }
}
