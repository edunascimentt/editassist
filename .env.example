# Copy to .env (setup does it) and fill what you use. Everything is optional except for the
# features that need it.

# ElevenLabs: voiceover, sound effects, music. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Pexels: free stock b-roll search. https://www.pexels.com/api/
PEXELS_API_KEY=

# Higgsfield: generated video shots and images. https://console.higgsfield.ai
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# generations estimated above this many USD need explicit confirmation (--yes)
EA_HF_MAX_USD=2

# Whisper model: large-v3-turbo (default), large-v3 (best), small (fast drafts)
EA_WHISPER_MODEL=large-v3-turbo

# Hugging Face token for automatic speaker detection (`uv sync --extra diarize`). Optional.
HF_TOKEN=
